# GS TOP DRINKS - Environment Variables
# Copie para .env.local e preencha com seus valores

# Google Analytics 4 Measurement ID (ex: G-XXXXXXXXXX)
VITE_GA_ID=

# WhatsApp número (ex: 5547992791968)
VITE_WHATSAPP=

# Instagram handle (ex: @gstopdrinks)
VITE_INSTAGRAM=

# Supabase (banco de dados de comandas)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Senha de acesso ao dashboard admin (/admin)
VITE_ADMIN_PASSWORD=
